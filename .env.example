# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0

# Database: leave blank to auto-detect an existing legacy DB first.
# MONITOR_DB=data/enterprise.db
MONITOR_DB=

# Endpoint agent authentication
MONITOR_API_KEY=replace-with-a-long-random-api-key
ONLINE_WINDOW_SECONDS=180

# AI defaults
AI_DEFAULT_PROVIDER=ollama
AI_DEFAULT_MODEL=llama3.2
AI_DEFAULT_TIMEOUT=60

# Optional online AI values can be configured from the UI.
# Never commit real API keys to this file.
